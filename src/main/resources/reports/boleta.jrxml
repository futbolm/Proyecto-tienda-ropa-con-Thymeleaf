<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="boleta" pageWidth="300" pageHeight="600" columnWidth="260"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="numBoleta"     class="java.lang.Integer"/>
    <parameter name="fechaBoleta"   class="java.lang.String"/>
    <parameter name="clienteId"     class="java.lang.Integer"/>
    <parameter name="nombreCliente" class="java.lang.String"/>
    <parameter name="totalBoleta"   class="java.lang.Double"/>

    <field name="desProd"  class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio"   class="java.lang.Double"/>

    <title>
        <band height="230">

            <staticText>
                <reportElement x="0" y="0" width="260" height="28"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true" fontName="Serif"/>
                </textElement>
                <text><![CDATA[MAISON]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="28" width="260" height="12"/>
                <textElement textAlignment="Center">
                    <font size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[Moda & Estilo — Nueva Colección 2025]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="40" width="260" height="12"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <text><![CDATA[RUC: 20987654321  |  Av. Moda 456, Lima, Perú]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="56" width="260" height="10"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[- - - - - - - - - - - - - - - - - - - - - - -]]></text>
            </staticText>

            <staticText>
			    <reportElement x="0" y="66" width="260" height="20" 
			                   backcolor="#16140f" forecolor="#F5F0E8" mode="Opaque"/>
			    <textElement textAlignment="Center" verticalAlignment="Middle">
			        <font size="10" isBold="true"/>
			    </textElement>
			    <text><![CDATA[BOLETA DE VENTA]]></text>
			</staticText>

            <textField>
                <reportElement x="0" y="91" width="260" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["N° Operación : " + $P{numBoleta}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="105" width="260" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Fecha Emisión : " + $P{fechaBoleta}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="124" width="260" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[CLIENTE:]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="136" width="260" height="15"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{nombreCliente}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="155" width="260" height="10"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[- - - - - - - - - - - - - - - - - - - - - - -]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="167" width="260" height="12"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL PAGADO]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="179" width="260" height="24"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["S/ " + String.format("%.2f", $P{totalBoleta})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="207" width="260" height="10"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[- - - - - - - - - - - - - - - - - - - - - - -]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="217" width="130" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[DETALLE DE COMPRA]]></text>
            </staticText>

        </band>
    </title>

    <columnHeader>
        <band height="16">
            <staticText>
                <reportElement x="0"   y="0" width="140" height="14" backcolor="#C9B89A" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[  Producto]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="0" width="35"  height="14" backcolor="#C9B89A" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[Cant.]]></text>
            </staticText>
            <staticText>
                <reportElement x="175" y="0" width="40"  height="14" backcolor="#C9B89A" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[P.Unit  ]]></text>
            </staticText>
            <staticText>
                <reportElement x="215" y="0" width="45"  height="14" backcolor="#C9B89A" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[Subtotal  ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isStretchWithOverflow="true">
                <reportElement x="0"   y="2" width="140" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{desProd}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="2" width="35"  height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="175" y="2" width="40"  height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["S/ " + String.format("%.2f", $F{precio})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="215" y="2" width="45"  height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["S/ " + String.format("%.2f", $F{cantidad} * $F{precio})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="90">

            <staticText>
                <reportElement x="0" y="0" width="260" height="10"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[- - - - - - - - - - - - - - - - - - - - - - -]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="10" width="180" height="16"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>

            <textField>
                <reportElement x="180" y="10" width="80" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["S/ " + String.format("%.2f", $P{totalBoleta})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="32" width="260" height="10"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[- - - - - - - - - - - - - - - - - - - - - - -]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="44" width="260" height="16"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[¡GRACIAS POR TU COMPRA!]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="60" width="260" height="12"/>
                <textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement>
                <text><![CDATA[Conserva este recibo como comprobante de pago]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="74" width="260" height="12"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <text><![CDATA[www.maison.pe  |  contacto@maison.pe]]></text>
            </staticText>

        </band>
    </summary>

</jasperReport>